# Cấu hình Model chính (Không điền API key thật vào file này)
SE373_MODEL="gemini-2.5-flash"
GEMINI_API_KEY="YOUR_API_KEY_HERE"
OPENAI_API_KEY="YOUR_API_KEY_HERE"

# Khóa cứng Embedding Model & Reranker cho cả 2 pha Ingest và Search
EMBEDDING_MODEL_NAME="text-embedding-3-small"
RERANKER_MODEL_NAME="cross-encoder/mmarco-mMiniLMv2-L12-H384-v1"

# Cấu hình Checkpointer & Lưu trữ dữ liệu cá nhân (Data Retention)
CHECKPOINT_DB_PATH="sqlite:///session_state.sqlite"
RETENTION_DAYS_CV_TRANSCRIPT=90
RETENTION_DAYS_AUDIO=30

# Cấu hình Docker Sandbox cô lập (UC-04)
SANDBOX_IMAGE="se373-interview-sandbox:latest"
SANDBOX_MEMORY_LIMIT="256m"
SANDBOX_CPU_LIMIT="0.5"
SANDBOX_TIMEOUT_SEC=10
